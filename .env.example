# 연말정산 시뮬레이터 환경변수 템플릿
# 이 파일을 복사해 루트에 .env 를 만든다 (cp .env.example .env). backend/frontend가 함께 사용한다.
# 주의: VITE_ 접두사가 붙은 변수만 브라우저 번들에 노출된다. 비밀값에는 절대 VITE_를 붙이지 않는다.

# 실행 환경: local | test | production (test면 인메모리 SQLite 사용)
APP_ENV=local
# 백엔드 개발 서버 호스트/포트 (`uv run python -m app`이 사용). 포트를 바꾸면 VITE_API_BASE_URL도 함께 바꾼다.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8100
# MySQL 접속 정보 (연결 URL은 백엔드가 조립하며 utf8mb4를 사용한다)
# DB가 없으면 backend/에서 `uv run python -m app.scripts.create_database`로 생성한다 (테이블은 앱 시작 시 자동 생성).
DB_HOST=localhost
DB_PORT=3306
DB_USER=tax_simulator
# 비밀번호는 특수문자를 그대로 입력한다 (URL 인코딩 불필요). 절대 VITE_ 접두사를 붙이지 않는다.
DB_PASSWORD=change-me
DB_NAME=tax_simulator
# OpenAI (결과 화면 AI 추천). 키가 없으면 AI 추천만 비활성화(503)되고 나머지 기능은 정상 동작한다.
# 비밀값이므로 절대 VITE_ 접두사를 붙이지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# OpenAI 응답 대기 시간(초)
OPENAI_TIMEOUT_SECONDS=60
# 허용할 프론트엔드 Origin (쉼표로 여러 개). APP_ENV=local이면 localhost·127.0.0.1의 모든 포트도 허용한다.
CORS_ORIGINS=http://localhost:5173
# 기본 귀속연도
DEFAULT_TAX_YEAR=2025
# 프론트엔드가 호출할 API 기본 URL (브라우저 노출됨)
VITE_API_BASE_URL=http://localhost:8100/api/v1
